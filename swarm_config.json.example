{
  "_comment": "Portable named-profile example. Keep secrets in environment variables. OPENAI_* is primary; LITELLM_API_KEY and LITELLM_BASE_URL are compatibility aliases only. Model selection belongs in this file, not environment variables.",
  "llm": {
    "default": {
      "provider": "openai",
      "model": "gpt-5.5",
      "base_url": "${OPENAI_BASE_URL}",
      "api_key": "${OPENAI_API_KEY}",
      "intelligence": 0.6,
      "speed": 0.6,
      "cost": 0.6
    },
    "reason": {
      "provider": "openai",
      "model": "gpt-5.5",
      "base_url": "${OPENAI_BASE_URL}",
      "api_key": "${OPENAI_API_KEY}",
      "intelligence": 0.95,
      "reasoning_effort": "high"
    },
    "classify": {
      "provider": "openai",
      "model": "gpt-5.4-mini",
      "base_url": "${OPENAI_BASE_URL}",
      "api_key": "${OPENAI_API_KEY}",
      "temperature": 0.0,
      "speed": 0.8,
      "cost": 0.8
    },
    "groq-example": {
      "provider": "openai",
      "model": "deepseek-r1-distill-llama-70b",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key": "${GROQ_API_KEY}",
      "passthrough": true
    }
  },
  "settings": {
    "default_llm_profile": "default",
    "default_markdown_output": true
  },
  "blueprints": {
    "codey": {
      "llm_profile": "reason"
    }
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${ALLOWED_PATH}"
      ],
      "env": {
        "ALLOWED_PATH": "${ALLOWED_PATH}"
      }
    }
  }
}
